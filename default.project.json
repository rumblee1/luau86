{
  "name": "Luau86 Emulator",
  "emitLegacyScripts": false,
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "luau86": {
        "$path": "src"
      }
    }
  },
  "globIgnorePaths": [
    "**/.luau86-*",
    "**/.luau86-*/**",
    "src/media/AtBios.luau",
    "src/media/Bios.luau",
    "src/media/BootTest.luau",
    "src/media/Disk.luau",
    "src/media/DiskRom.luau",
    "src/media/VgaBios.luau",
    "src/media/vga_windows_disk",
    "src/media/vga_windows_standard_disk"
  ]
}
